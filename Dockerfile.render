FROM python:3.12-alpine@sha256:b658b05ce9c4eb97ec6fc19424818a1f31993659c2b505a532f470e83807815d AS base
WORKDIR /app
RUN apk upgrade --no-cache && addgroup -g 1000 app && adduser -D -H -u 10001 -G app app
COPY Back__end/requirements.txt Back__end/requirements.lock ./
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.txt && python -m pip uninstall -y pip
COPY --chown=10001:1000 Back__end/app ./app
COPY --chown=10001:1000 Front__end /frontend
COPY --chown=10001:1000 deploy/render_start.py /app/render_start.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:1000
EXPOSE 10000
CMD ["python", "/app/render_start.py"]

FROM base AS test
USER root
RUN python -m ensurepip && python -m pip install --no-cache-dir pip==26.2.2
COPY tests/requirements-dev.txt /tests/requirements-dev.txt
RUN python -m pip install --no-cache-dir -r /tests/requirements-dev.txt
COPY Back__end /workspace/Back__end
COPY Front__end /workspace/Front__end
COPY tests /workspace/tests
COPY deploy /workspace/deploy
COPY pytest.ini /workspace/pytest.ini
WORKDIR /workspace
ENV PYTHONPATH=/workspace/Back__end:/workspace/tests
USER 10001:1000
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]

# Default build must run the application, never the test stage.
FROM base AS runtime
