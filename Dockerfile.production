FROM python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203 AS runtime
WORKDIR /app
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
COPY Back__end/requirements.txt Back__end/requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt \
    && python -m pip uninstall -y pip \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app
COPY --chown=10001:10001 Back__end/app ./app
COPY --chown=10001:10001 Front__end /frontend
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD python -c "import os,urllib.request,urllib.parse; urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8000/health', headers={'Host':urllib.parse.urlsplit(os.getenv('PUBLIC_ORIGIN','http://localhost')).netloc}), timeout=3)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-server-header", "--no-proxy-headers"]

FROM runtime AS test
USER root
COPY Back__end /workspace/Back__end
COPY Front__end /workspace/Front__end
COPY tests /workspace/tests
WORKDIR /workspace
RUN python -m ensurepip && python -m pip install --no-cache-dir pip==26.2.2 \
    && python -m pip install --no-cache-dir -r tests/requirements-dev.txt
USER 10001:10001
ENV PYTHONPATH=/workspace/Back__end:/workspace/tests
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
