# Production template. Copy to .env.production; never commit populated values.
APP_ENV=production
PUBLIC_ORIGIN=https://powertrack.example.invalid
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
AUTH_COOKIE_NAME=__Host-powertrack_access_token
JWT_SECRET_KEY=
REDIS_PASSWORD=
GOOGLE_SPREADSHEET_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://powertrack.example.invalid/api/auth/google/callback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ADVICE_PROVIDER_RPM=10
ADVICE_PROVIDER_DAILY_LIMIT=100
# Compose-only variables, paths must refer to your deployment host.
GOOGLE_CREDENTIALS_FILE=
TRUSTED_PROXY_IPS=

# Render uses an internal URL instead of REDIS_HOST/REDIS_PASSWORD.
# REDIS_URL=redis://<private-host>:6379/0
# REDIS_ALLOW_PASSWORDLESS_PRIVATE=true
